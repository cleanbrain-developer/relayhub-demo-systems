# Where RelayHub's ingress API is reachable from this simulator.
RELAYHUB_BASE_URL=http://localhost:8080

# Port this simulator listens on for the Target endpoints RelayHub delivers to.
PORT=9500

# How often (ms) the scheduler generates one flight-created/flight-status-updated event.
EVENT_INTERVAL_MS=5000

# Cap on concurrently "live" (non-terminal) simulated flights.
MAX_LIVE_FLIGHTS=8

# Fraction of /targets/travelapp-vendor requests that fail (split between an immediate 503 and a
# delayed 504), simulating a flaky third-party vendor. 0 = always succeeds, 1 = always fails.
TRAVELAPP_VENDOR_FAILURE_RATE=0.4

# How long (ms) the delayed-failure half of TRAVELAPP_VENDOR_FAILURE_RATE waits before responding.
TRAVELAPP_VENDOR_TIMEOUT_MS=6000
